# Marketplace URL or country key (e.g. Switzerland, Germany, Debug)
ALSO_CLOUD_MARKETPLACE=https://marketplace.also.ch

# API credentials
ALSO_CLOUDUSER=you@example.com
ALSO_CLOUDPW=your-password

# Optional: default parent for find_companies / list_company_subscriptions (reseller/company account that owns end customers)
# ALSO_CLOUD_PARENT_ACCOUNT_ID=315818

# Optional overrides
# ALSO_CLOUD_API_PREFIX=/SimpleAPI/SimpleAPIService.svc/rest
# ALSO_CLOUD_TIMEOUT_MS=30000
